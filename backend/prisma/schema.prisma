generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum WatchStatus {
  PLANNED
  WATCHING
  COMPLETED
  DROPPED
  FAVORITE
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  bio          String        @default("")
  avatarUrl    String?
  passwordHash String
  role         Role          @default(USER)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  watchItems   WatchItem[]
  ratings      Rating[]
  comments     Comment[]
  lists        PersonalList[]
  reports      Report[]
  episodeProgress EpisodeProgress[]
}

model Media {
  id          String       @id
  type        String
  title       String
  year        Int?
  plot        String?
  posterUrl   String?
  genres      String?
  cast        String?
  director    String?
  country     String?
  runtimeMinutes Int?
  imdbRating  Float?
  totalSeasons Int?
  rawJson     String?
  cachedAt    DateTime     @default(now())
  watchItems  WatchItem[]
  ratings     Rating[]
  comments    Comment[]
  listItems   ListItem[]
  episodeProgress EpisodeProgress[]
}

model WatchItem {
  id             String      @id @default(cuid())
  userId         String
  mediaId        String
  status         WatchStatus @default(PLANNED)
  watchedEpisodes Int        @default(0)
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  media          Media       @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  mediaId   String
  value     Int
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  mediaId   String
  text      String
  spoiler   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  reports   Report[]
}

model PersonalList {
  id        String     @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ListItem[]

  @@unique([userId, name])
}

model ListItem {
  id        String       @id @default(cuid())
  listId    String
  mediaId   String
  createdAt DateTime     @default(now())
  list      PersonalList @relation(fields: [listId], references: [id], onDelete: Cascade)
  media     Media        @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([listId, mediaId])
}

model Report {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  reason    String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
}

model EpisodeProgress {
  id        String   @id @default(cuid())
  userId    String
  mediaId   String
  season    Int
  episode   Int
  watchedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId, season, episode])
  @@index([userId, mediaId])
}
